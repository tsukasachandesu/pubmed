# Core PubMed settings
PUBMED_EMAIL=you@example.com
# PUBMED_API_KEY=your_ncbi_api_key
PUBMED_TOOL_NAME=pubmed-cli
PUBMED_DATA_DIR=data/papers
PUBMED_ENABLE_SCIHUB=false
PUBMED_LOG_LEVEL=INFO
PUBMED_LOG_FORMAT=console

# Unpaywall contact address (optional)
# PUBMED_UNPAYWALL_EMAIL=you@example.com

# HTTP proxy for adapters (optional)
# PUBMED_PROXY_URL=http://localhost:8080

# Botasaurus integration
# BOTASAURUS_PROFILE=default
# BOTASAURUS_MAX_BROWSERS=2
# BOTASAURUS_PROXY=http://localhost:8080

# Observability (OpenTelemetry)
# OBS_ENABLED=false
# OBS_SERVICE_NAME=pubmed
# OBS_OTLP_ENDPOINT=http://localhost:4318
# OBS_SAMPLING_RATIO=1.0
